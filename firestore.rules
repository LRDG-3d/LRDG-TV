rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /episodios/{id} {
      allow read: if true;
      // Cambia el correo por el de tu usuario admin
      allow write: if request.auth != null
        && request.auth.token.email == "TU-CORREO@gmail.com";
    }
  }
}
