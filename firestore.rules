rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /producciones/{id} {
      allow read: if true;
      // Cambia TU_UID por el UID de tu usuario (Authentication → Users)
      allow write: if request.auth != null && request.auth.uid == 'TU_UID';
    }
  }
}
